<resources>
    <!-- Base tactical theme -->
    <style name="Theme.GodsEyeMobile" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/tactical_bg</item>
        <item name="android:navigationBarColor">@color/tactical_bg</item>
        <item name="android:windowBackground">@color/tactical_bg</item>
        <item name="colorPrimary">@color/tactical_cyan</item>
        <item name="colorSecondary">@color/tactical_amber</item>
    </style>

    <!-- Tactical Dialog Theme -->
    <style name="Theme.GodsEyeMobile.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:background">@color/tactical_card</item>
        <item name="colorSurface">@color/tactical_card</item>
        <item name="colorPrimary">@color/tactical_cyan</item>
        <item name="colorOnSurface">@color/tactical_text</item>
    </style>
</resources>
